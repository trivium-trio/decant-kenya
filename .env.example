# ==============================================================================
# Decant Kenya Storefront - Environment Configuration
# ==============================================================================

# Data Adapter Mode
# Determines which data adapter ShopApi uses:
# - "mock": Uses in-memory mock catalog and fixtures (default for local storefront development)
# - "remote": Connects to the live backend API (Payload CMS)
SHOP_API_PROVIDER=mock
# Legacy alias for SHOP_API_PROVIDER (supported as fallback)
API_MODE=mock

# Live Backend Connection (required when SHOP_API_PROVIDER=remote)
# Base URL of the backend API (e.g. Payload CMS on port 5000 or ngrok tunnel)
BACKEND_URL=http://localhost:5000
# Optional client-accessible backend URL fallback
NEXT_PUBLIC_SERVER_URL=http://localhost:5000

# Storefront API Key
# Pre-shared secret sent via X-Storefront-Key header to authorize storefront calls
STOREFRONT_API_KEY=your_storefront_api_key_here

# Cache Revalidation Secret
# Required by POST /api/revalidate (sent in x-revalidate-secret header)
# Used by backend webhooks to trigger on-demand ISR cache revalidation
REVALIDATE_SECRET=your_revalidate_secret_key_here

# Storefront Public URL
# Canonical base URL used for metadata, OpenGraph tags, and sitemaps
NEXT_PUBLIC_SITE_URL=http://localhost:3000
